# Copy to .env and fill in. Anything left blank runs in safe "demo" mode.

# Local Docker Postgres (`docker compose up -d`). On Vercel the Neon integration sets both.
DATABASE_URL="postgresql://junkyard:junkyard@localhost:5433/junkyardgold"
DATABASE_URL_UNPOOLED="postgresql://junkyard:junkyard@localhost:5433/junkyardgold"

# Public site URL (used in text messages and Stripe redirects)
SITE_URL="http://localhost:3000"

# Staff inbox login (/admin). Use a long random password.
ADMIN_PASSWORD="change-me"
# Random string used to sign the admin login cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET="change-me-too"

# --- Claude (AI quote drafts). Blank = template drafts instead of AI. ---
ANTHROPIC_API_KEY=""

# --- RingCentral texting. Blank = texts are simulated and only shown in the inbox. ---
# developers.ringcentral.com → Console → create a "REST API" app with JWT auth and the SMS + Read Messages
# + Webhook Subscriptions permissions, then create a JWT credential for the user who owns 847-874-5972.
RINGCENTRAL_SERVER="https://platform.ringcentral.com"
RINGCENTRAL_CLIENT_ID=""
RINGCENTRAL_CLIENT_SECRET=""
RINGCENTRAL_JWT=""
RINGCENTRAL_FROM_NUMBER="+18478745972"
# Random string RingCentral echoes on every webhook so we know it's them (openssl rand -hex 24)
RINGCENTRAL_WEBHOOK_TOKEN=""
# Optional: staff cell that gets a text alert for every new lead
STAFF_ALERT_PHONE=""

# --- Stripe payments. Blank = "Buy" asks the customer to call/text instead. ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email alerts & checkout orders (Gmail SMTP). Generate a 16-character App Password: myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="junkyardgoldinc@gmail.com"
SMTP_PASS=""
NOTIFY_TO="adam@tagoreautoparts.com"
